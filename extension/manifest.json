{
  "manifest_version": 3,
  "name": "Panelize Local · 豆包",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://www.doubao.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "连接本地比较工具"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/*"
      ],
      "js": [
        "vendor/button-finder-utils.js",
        "vendor/doubao-input.js",
        "doubao.js"
      ]
    }
  ]
}
